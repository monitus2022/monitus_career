# .env.example — copy to .env (gitignored) and fill at checkpoint H3.
# All keys optional for local/dry-run development.

# Cloudflare (H3) — used by uploads, Pages Function deploy, write-back reads
CF_ACCOUNT_ID=
CF_API_TOKEN=
R2_BUCKET=monitus-career-data

# Access (served site)
ACCESS_TEAM_NAME=monitus

# Routing
SITE_BASE_URL=https://career.monitus.org

# LLM parse-fallback hook — MUST stay empty unless the human explicitly
# opts in later (the build plan requires fallback OFF by default).
LLM_FALLBACK=
LLM_API_KEY=
LLM_MODEL=
